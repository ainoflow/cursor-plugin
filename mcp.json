{
  "mcpServers": {
    "ainoflow-memory": {
      "type": "http",
      "url": "https://mcp.ainoflow.io/mcp/v1/memory",
      "headers": {
        "Authorization": "Bearer ${AINOFLOW_API_KEY}"
      }
    },
    "ainoflow-files": {
      "type": "http",
      "url": "https://mcp.ainoflow.io/mcp/v1/files",
      "headers": {
        "Authorization": "Bearer ${AINOFLOW_API_KEY}"
      }
    },
    "ainoflow-storage": {
      "type": "http",
      "url": "https://mcp.ainoflow.io/mcp/v1/storage/json",
      "headers": {
        "Authorization": "Bearer ${AINOFLOW_API_KEY}"
      }
    },
    "ainoflow-inbox": {
      "type": "http",
      "url": "https://mcp.ainoflow.io/mcp/v1/inbox",
      "headers": {
        "Authorization": "Bearer ${AINOFLOW_API_KEY}"
      }
    }
  }
}
